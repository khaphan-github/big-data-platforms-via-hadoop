# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=rss_password
MYSQL_DATABASE=rss_ingest

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ingest.log

# Scheduler
INGEST_INTERVAL_MINUTES=30
MAX_RETRIES=4
REQUEST_TIMEOUT_SECONDS=10

# Data Processing
MAX_DESCRIPTION_LENGTH=5000
BATCH_SIZE=100

# HDFS / Data Lake
HDFS_ENABLED=true
HDFS_WEBHDFS_URL=http://localhost:9870
HDFS_USER=root
HDFS_ARTICLES_PATH=/data/rss/articles
HDFS_TIMEOUT_SECONDS=30

# Hive
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=rss_analytics
HIVE_ARTICLES_TABLE=rss_articles
HIVE_AUTH_MODE=NONE
HIVE_SYNC_ENABLED=true

# Superset
SUPERSET_SECRET_KEY=rss_superset_secret_change_me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=RSS
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_DATABASE_NAME=rss_hive
SUPERSET_DATABASE_URI=hive://hive-server:10000/rss_analytics
SUPERSET_DATASET_SCHEMA=rss_analytics
SUPERSET_DATASET_TABLE=rss_articles
SUPERSET_DATASET_LABEL=RSS Articles
