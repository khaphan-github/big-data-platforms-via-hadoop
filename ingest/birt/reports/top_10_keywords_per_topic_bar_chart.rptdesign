<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
  <property name="createdBy">Gemini CLI</property>
  <property name="units">in</property>
  <data-sources>
    <oda-data-source extensionID="org.eclipse.birt.report.data.oda.jdbc" name="MySQLDataSource" id="2">
      <property name="odaDriverClass">com.mysql.cj.jdbc.Driver</property>
      <property name="odaURL">jdbc:mysql://mysql:3306/rss_ingest?useSSL=false&amp;serverTimezone=UTC</property>
      <property name="odaUser">root</property>
      <property name="odaPassword">rss_password</property>
    </oda-data-source>
  </data-sources>
  <data-sets>
    <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc" name="Top10KeywordsPerTopic" id="3">
      <property name="dataSource">MySQLDataSource</property>
      <property name="queryText">
        WITH RankedKeywords AS (
            SELECT
                chu_de,
                tu_khoa,
                SUM(so_lan_xuat_hien) AS total_occurrences,
                ROW_NUMBER() OVER (PARTITION BY chu_de ORDER BY SUM(so_lan_xuat_hien) DESC) as rn
            FROM trending_words
            GROUP BY chu_de, tu_khoa
        )
        SELECT
            chu_de,
            tu_khoa,
            total_occurrences
        FROM RankedKeywords
        WHERE rn &lt;= 10
        ORDER BY chu_de, total_occurrences DESC;
      </property>
      <structure name="cachedMetaData">
        <property name="resultSetItemCount">3</property>
        <result-set-column name="chu_de" position="1" dataType="string"/>
        <result-set-column name="tu_khoa" position="2" dataType="string"/>
        <result-set-column name="total_occurrences" position="3" dataType="integer"/>
      </structure>
    </oda-data-set>
  </data-sets>
  <body>
    <graphic-element xsi:type="chart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="4">
      <property name="top">0.0in</property>
      <property name="left">0.0in</property>
      <property name="width">10.0in</property>
      <property name="height">6.0in</property>
      <property name="data-set">Top10KeywordsPerTopic</property>
      <property name="title">Top 10 Keywords Per Topic</property>
      <property name="type">Bar</property>
      <property name="subtype">SideBySide</property>
      <property name="category-series">
        <property name="data-set-column">tu_khoa</property>
      </property>
      <property name="value-series">
        <property name="data-set-column">total_occurrences</property>
      </property>
      <property name="group-series">
        <property name="data-set-column">chu_de</property>
      </property>
    </graphic-element>
  </body>
</report>