<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design"
        version="3.2.23"
        id="1">
  <property name="createdBy">Codex</property>
  <property name="units">in</property>
  <data-sources>
    <oda-data-source extensionID="org.eclipse.birt.report.data.oda.jdbc" name="MySQLDataSource" id="2">
      <property name="odaDriverClass">com.mysql.cj.jdbc.Driver</property>
      <property name="odaURL">jdbc:mysql://mysql:3306/rss_ingest?useSSL=false&amp;serverTimezone=UTC</property>
      <property name="odaUser">root</property>
      <property name="odaPassword">rss_password</property>
    </oda-data-source>
  </data-sources>
  <data-sets>
    <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc" name="ArticlesByDay" id="3">
      <property name="dataSource">MySQLDataSource</property>
      <property name="queryText">SELECT DATE(fetched_date) AS day, COUNT(*) AS article_count FROM articles GROUP BY DATE(fetched_date) ORDER BY day</property>
    </oda-data-set>
  </data-sets>
  <body>
    <!-- Starter template: add a time-series chart in BIRT Designer using the ArticlesByDay dataset. -->
  </body>
</report>
